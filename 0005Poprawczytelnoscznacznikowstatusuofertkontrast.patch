Subject: [PATCH 5/5] Popraw czytelnosc znacznikow statusu ofert (kontrast tla
 badge'y)

---
 oferty.html | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/oferty.html b/oferty.html
index 4f259ce..dec5d05 100644
--- a/oferty.html
+++ b/oferty.html
@@ -117,10 +117,10 @@ nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:cen
 .cimg img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
 .card:hover .cimg img{transform:scale(1.04)}
 .cimg-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:2.5rem;background:linear-gradient(135deg,#e8e0d0,#d8d0c0)}
-.cstatus{position:absolute;top:10px;left:10px;padding:.28rem .8rem;border-radius:100px;font-size:.7rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;backdrop-filter:blur(8px)}
-.s-av{background:rgba(34,197,94,.15);color:#14532d;border:1px solid rgba(34,197,94,.3)}
-.s-so{background:rgba(245,158,11,.15);color:#78350f;border:1px solid rgba(245,158,11,.3)}
-.s-tk{background:rgba(156,163,175,.15);color:#374151;border:1px solid rgba(156,163,175,.3)}
+.cstatus{position:absolute;top:10px;left:10px;padding:.28rem .8rem;border-radius:100px;font-size:.7rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;backdrop-filter:blur(8px);box-shadow:0 1px 5px rgba(0,0,0,.18)}
+.s-av{background:#DCFCE7;color:#14532d;border:1px solid rgba(34,197,94,.35)}
+.s-so{background:#FEF3C7;color:#78350f;border:1px solid rgba(245,158,11,.35)}
+.s-tk{background:#E5E7EB;color:#374151;border:1px solid rgba(156,163,175,.45)}
 .ctype{position:absolute;top:10px;right:10px;background:rgba(26,26,24,.75);color:var(--white);padding:.26rem .72rem;border-radius:100px;font-size:.68rem;font-weight:500;backdrop-filter:blur(8px)}
 .cbody{padding:1.3rem}
 .cbadge{font-size:.68rem;color:var(--accent);font-weight:600;letter-spacing:.04em;margin-bottom:.2rem}
