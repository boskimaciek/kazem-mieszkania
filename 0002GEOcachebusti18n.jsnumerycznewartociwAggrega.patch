+        {"@type": "Review", "reviewRating": {"@type": "Rating", "ratingValue": 5, "bestRating": 5}, "author": {"@type": "Person", "name": "Marek K."}, "reviewBody": "Kasia zajmuje się moimi trzema mieszkaniami od lat. Nigdy nie musiałem jechać na miejsce — czynsz wpływa co miesiąc."},
+        {"@type": "Review", "reviewRating": {"@type": "Rating", "ratingValue": 5, "bestRating": 5}, "author": {"@type": "Person", "name": "Anna W."}, "reviewBody": "Wreszcie mogę spać spokojnie. Kasia znalazła studentów, podpisała umowy i zajęła się usterką — wszystko bez mojego udziału."},
